{
  "name": "@aikit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "seed": "node ./scripts/seed.mjs",
    "migrate:local": "wrangler d1 migrations apply ai-kit --local",
    "migrate:remote": "wrangler d1 migrations apply ai-kit --remote"
  },
  "dependencies": {
    "@aikit/shared": "workspace:*",
    "@modelcontextprotocol/server": "^2.2.0",
    "agents": "^0.24.0",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.15",
    "jose": "^5.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20241230.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.20.0"
  }
}
